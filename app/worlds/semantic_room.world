<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="semantic_room">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <scene>
      <ambient>0.32 0.32 0.32 1</ambient>
      <background>0.68 0.72 0.76 1</background>
      <shadows>0</shadows>
    </scene>
    <light name="ceiling" type="point">
      <pose>0.3 0 2.4 0 0 0</pose>
      <diffuse>0.4 0.4 0.38 1</diffuse>
      <specular>0.04 0.04 0.04 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.55</constant>
        <linear>0.18</linear>
        <quadratic>0.05</quadratic>
      </attenuation>
      <cast_shadows>0</cast_shadows>
    </light>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
    </physics>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.2 -5.2 3.2 0 0.55 1.5708</pose>
      </camera>
    </gui>

    <model name="walls">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="north"><pose>0.05 2.0 0.5 0 0 0</pose><geometry><box><size>4.5 0.1 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="north"><pose>0.05 2.0 0.5 0 0 0</pose><geometry><box><size>4.5 0.1 1.0</size></box></geometry></collision>
        <visual name="south"><pose>0.05 -2.0 0.5 0 0 0</pose><geometry><box><size>4.5 0.1 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="south"><pose>0.05 -2.0 0.5 0 0 0</pose><geometry><box><size>4.5 0.1 1.0</size></box></geometry></collision>
        <visual name="west"><pose>-2.2 0 0.5 0 0 0</pose><geometry><box><size>0.1 4.0 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="west"><pose>-2.2 0 0.5 0 0 0</pose><geometry><box><size>0.1 4.0 1.0</size></box></geometry></collision>
        <visual name="east_south"><pose>2.3 -1.225 0.5 0 0 0</pose><geometry><box><size>0.1 1.55 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="east_south"><pose>2.3 -1.225 0.5 0 0 0</pose><geometry><box><size>0.1 1.55 1.0</size></box></geometry></collision>
        <visual name="east_north"><pose>2.3 1.225 0.5 0 0 0</pose><geometry><box><size>0.1 1.55 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="east_north"><pose>2.3 1.225 0.5 0 0 0</pose><geometry><box><size>0.1 1.55 1.0</size></box></geometry></collision>
      </link>
    </model>

    <!-- Target chair: shares Gazebo/Wood material and footprint with the crate, distinguished by its backrest and legs. -->
    <model name="chair">
      <static>true</static>
      <pose>1.35 0.65 0 0 0 0</pose>
      <link name="link">
        <visual name="seat"><pose>0 0 0.28 0 0 0</pose><geometry><box><size>0.40 0.40 0.05</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="seat"><pose>0 0 0.28 0 0 0</pose><geometry><box><size>0.40 0.40 0.05</size></box></geometry></collision>
        <visual name="back"><pose>0.18 0 0.52 0 0 0</pose><geometry><box><size>0.05 0.40 0.46</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="back"><pose>0.18 0 0.52 0 0 0</pose><geometry><box><size>0.05 0.40 0.46</size></box></geometry></collision>
        <visual name="leg_fl"><pose>0.16 0.16 0.14 0 0 0</pose><geometry><box><size>0.04 0.04 0.28</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="leg_fl"><pose>0.16 0.16 0.14 0 0 0</pose><geometry><box><size>0.04 0.04 0.28</size></box></geometry></collision>
        <visual name="leg_fr"><pose>0.16 -0.16 0.14 0 0 0</pose><geometry><box><size>0.04 0.04 0.28</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="leg_fr"><pose>0.16 -0.16 0.14 0 0 0</pose><geometry><box><size>0.04 0.04 0.28</size></box></geometry></collision>
        <visual name="leg_bl"><pose>-0.16 0.16 0.14 0 0 0</pose><geometry><box><size>0.04 0.04 0.28</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="leg_bl"><pose>-0.16 0.16 0.14 0 0 0</pose><geometry><box><size>0.04 0.04 0.28</size></box></geometry></collision>
        <visual name="leg_br"><pose>-0.16 -0.16 0.14 0 0 0</pose><geometry><box><size>0.04 0.04 0.28</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="leg_br"><pose>-0.16 -0.16 0.14 0 0 0</pose><geometry><box><size>0.04 0.04 0.28</size></box></geometry></collision>
      </link>
    </model>

    <!-- Decoy wooden crate: identical wood texture and width to the chair, but not sittable. -->
    <model name="crate">
      <static>true</static>
      <pose>1.35 -0.65 0.22 0 0 0</pose>
      <link name="link">
        <visual name="body"><geometry><box><size>0.40 0.40 0.44</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="body"><geometry><box><size>0.40 0.40 0.44</size></box></geometry></collision>
      </link>
    </model>

    <!-- Low floor obstacle (height 0.04 m): sits below the 2D LiDAR scan plane (0.12 m) and requires visual detection. -->
    <model name="floor_object">
      <static>true</static>
      <pose>1.05 -0.55 0.02 0 0 0</pose>
      <link name="link">
        <visual name="body"><geometry><cylinder><radius>0.045</radius><length>0.04</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <collision name="body"><geometry><cylinder><radius>0.045</radius><length>0.04</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Table with clearance underneath that the robot should avoid entering. -->
    <model name="table">
      <static>true</static>
      <pose>-0.15 1.45 0 0 0 0</pose>
      <link name="link">
        <visual name="top"><pose>0 0 0.42 0 0 0</pose><geometry><box><size>0.80 0.50 0.04</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="top"><pose>0 0 0.42 0 0 0</pose><geometry><box><size>0.80 0.50 0.04</size></box></geometry></collision>
        <visual name="leg_fl"><pose>0.34 0.20 0.20 0 0 0</pose><geometry><box><size>0.04 0.04 0.40</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="leg_fl"><pose>0.34 0.20 0.20 0 0 0</pose><geometry><box><size>0.04 0.04 0.40</size></box></geometry></collision>
        <visual name="leg_fr"><pose>0.34 -0.20 0.20 0 0 0</pose><geometry><box><size>0.04 0.04 0.40</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="leg_fr"><pose>0.34 -0.20 0.20 0 0 0</pose><geometry><box><size>0.04 0.04 0.40</size></box></geometry></collision>
        <visual name="leg_bl"><pose>-0.34 0.20 0.20 0 0 0</pose><geometry><box><size>0.04 0.04 0.40</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="leg_bl"><pose>-0.34 0.20 0.20 0 0 0</pose><geometry><box><size>0.04 0.04 0.40</size></box></geometry></collision>
        <visual name="leg_br"><pose>-0.34 -0.20 0.20 0 0 0</pose><geometry><box><size>0.04 0.04 0.40</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="leg_br"><pose>-0.34 -0.20 0.20 0 0 0</pose><geometry><box><size>0.04 0.04 0.40</size></box></geometry></collision>
      </link>
    </model>

  </world>
</sdf>
